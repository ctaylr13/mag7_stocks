{
  "name": "mag7-returns-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:openapi": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/export_openapi.py && npx openapi-typescript backend/openapi.json -o src/types/api.d.ts",
    "gen:tickers": "PYTHONPATH=backend backend/.venv/bin/python backend/scripts/export_tickers.py",
    "gen": "npm run gen:openapi && npm run gen:tickers"
  },
  "dependencies": {
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@linaria/babel-preset": "^5.0.4",
    "@linaria/vite": "^5.0.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@wyw-in-js/vite": "^1.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
